# Alam Stores — site PHP + back-office
# The pages are PHP so the catalogue is rendered by the server. PHP runs at the
# document root and in api/, admin/ and includes/, and is refused everywhere
# else — assets/uploads/ above all. This file sets caching, compression
# and security headers, and restores the hardening that was stripped from the
# WordPress .htaccess during the compromise (see SECURITY-AUDIT.md §1.5).

# ---------------------------------------------------------------- routing --
DirectoryIndex index.php
ErrorDocument 404 /404.php

# Never serve a directory listing.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The pages used to be .html. Send those URLs to the extensionless address
  # once and for all, so what search engines indexed keeps its ranking.
  RewriteCond %{THE_REQUEST} "\s/+(.+)\.html[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Strip a trailing slash from what used to be a WordPress permalink.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Extensionless URLs: /pergolas -> /pergolas.php. Internal links carry the
  # .php extension so the site still works if this module is unavailable; the
  # canonical tag on every page points at the extensionless address.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L]

  # Une catégorie créée dans le back-office n'a pas de fichier à elle :
  # categorie.php la sert à partir de son slug. Si elle n'existe pas non plus
  # en base, cette page répond 404 elle-même.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)$ categorie.php?c=$1 [L,QSA]
</IfModule>

# --------------------------------------------------------------- security --
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Applies to the public pages. admin/.htaccess redefines it for the
  # back-office, which needs a wider policy for its inline script — an
  # "always set" here would otherwise overwrite what PHP sends.
  # reCAPTCHA needs google.com and gstatic.com; the product pop-up needs the
  # YouTube frame and its thumbnails. Nothing else is allowed.
  <FilesMatch "\.php$">
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://i.ytimg.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.google.com https://www.gstatic.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  </FilesMatch>

  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Server-side sources and data files are never served as content. PHP is NOT in
# this list: it is allowed under api/ and admin/ only, and blocked everywhere
# else by the per-directory .htaccess files (assets/uploads/ above all).
<FilesMatch "\.(phps|phtml|pht|pl|py|cgi|sh|bash|sql|log|bak|inc|ini|env|yml|yaml|lock|md)$">
  Require all denied
</FilesMatch>

# The configuration file carries the database password. It must never be read.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# Hide dotfiles (.git, .htaccess itself, editor leftovers).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# The build tooling and the SQL schema are source, not web content.
RedirectMatch 404 ^/tools/.*$
RedirectMatch 404 ^/db/.*$
RedirectMatch 404 ^/node_modules/.*$

# The repository itself. `<FilesMatch "^\.">` above only covers files, not the
# contents of a dot-directory: without this, /.git/config and the whole history
# would be downloadable when the repository root is the document root.
RedirectMatch 404 ^/\.git(/.*)?$
RedirectMatch 404 ^/\.github(/.*)?$

# ------------------------------------------------------------ compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ----------------------------------------------------------------- caching --
<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprint-free filenames, so keep HTML uncached and assets long-lived.
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------- mimetypes --
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
